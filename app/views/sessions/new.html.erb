<div class="signup-page">
  <div class="signup-container">
    <h1 class="signup-logo">Music Memories</h1>
    <p class="signup-message">好きな音楽に、あなたの言葉を。</p>

    <%= render "shared/flash" %>

    <div class="signup-card">
      <h2>ログイン</h2>
      <p class="signup-description">おかえりなさい。音楽の世界へ。</p>

      <%= form_with url: login_path, scope: :session, local: true do |form| %>
        <div class="form-group">
          <%= form.label :email, "メールアドレス" %>
          <%= form.email_field :email, placeholder: "example@email.com", required: true, autocomplete: "email" %>
        </div>

        <div class="form-group">
          <%= form.label :password, "パスワード" %>
          <%= form.password_field :password, placeholder: "パスワードを入力", required: true, autocomplete: "current-password" %>
        </div>

        <div class="signup-submit">
          <%= form.submit "ログイン" %>
        </div>
      <% end %>

      <p class="login-signup-link">
        アカウントをお持ちでない方は
        <%= link_to "新規登録", sign_up_path %>
      </p>
    </div>
  </div>
</div>