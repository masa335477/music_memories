<main class="memories-page">
  <div class="memories-container">
    <header class="memories-page-header">
      <h1 class="home-logo">
        <%= link_to "Music Memories", root_path, class: "home-logo-link" %>
      </h1>
      <span class="memories-page-title">投稿詳細</span>
    </header>

    <article class="memory-card memory-detail">
      <h2><%= @memory.title %></h2>

      <div class="memory-meta">
        <span>投稿者：<%= @memory.user.name %></span>
        <time datetime="<%= @memory.created_at.iso8601 %>">
          <%= @memory.created_at.strftime("%Y/%m/%d %H:%M") %>
        </time>
      </div>

      <div class="memory-body">
        <%= simple_format(@memory.body) %>
      </div>

      <%= render "memories/music_info", memory: @memory %>

      <div class="memory-reactions">
        <% if logged_in? %>
          <% if current_user.likes.exists?(memory_id: @memory.id) %>
            <%= button_to "共感を取り消す",
                  memory_like_path(@memory),
                  method: :delete,
                  class: "memories-button" %>
          <% else %>
            <%= button_to "共感",
                  memory_like_path(@memory),
                  method: :post,
                  class: "memories-button" %>
          <% end %>
        <% else %>
          <div class="memory-reactions-login">
            <p>共感を押すにはログインが必要です。</p>
            <%= link_to "ログイン",
                  login_path,
                  class: "memories-button" %>
          </div>
        <% end %>
        <span>共感：<%= @memory.likes.count %>件</span>
      </div>
    </article>

    <section class="comments-section">
      <h2>コメント（<%= @comments.size %>件）</h2>

      <% if @comments.any? %>
        <div class="comments-list">
          <%= render partial: "comments/comment",
                collection: @comments,
                as: :comment %>
        </div>
      <% else %>
        <p>まだコメントはありません。</p>
      <% end %>

      <div class="comment-form-container">
        <% if logged_in? %>
          <h3>コメントを投稿する</h3>
          <%= render "comments/form",
                memory: @memory,
                comment: @comment %>
        <% else %>
          <div class="comment-login-notice">
            <p>コメントするにはログインが必要です。</p>
            <%= link_to "ログインはこちら",
                  login_path,
                  class: "memories-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <nav class="memory-navigation" aria-label="ページ移動">
      <%= link_to "投稿一覧に戻る",
            memories_path,
            class: "memories-button" %>

      <% if logged_in? && @memory.user_id == current_user.id %>
        <%= link_to "編集する",
              edit_memory_path(@memory),
              class: "memories-button" %>

        <%= button_to "削除する",
              memory_path(@memory),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "この投稿を削除しますか？この操作は取り消せません。"
                }
              },
              class: "memories-button" %>
      <% end %>
    </nav>
  </div>
</main>
