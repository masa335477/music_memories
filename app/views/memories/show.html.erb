<main class="memories-page">
  <div class="memories-container">
    <header class="memories-page-header">
      <h1 class="home-logo">
        <%= link_to "Music Memories", root_path, class: "home-logo-link" %>
      </h1>
      <span class="memories-page-title">投稿詳細</span>
    </header>

    <article class="memory-card memory-detail">
      <h2><%= @memory.title %></h2>

      <div class="memory-meta">
        <span>投稿者：<%= @memory.user.name %></span>
        <time datetime="<%= @memory.created_at.iso8601 %>">
          <%= @memory.created_at.strftime("%Y/%m/%d %H:%M") %>
        </time>
      </div>

      <div class="memory-body">
        <%= simple_format(@memory.body) %>
      </div>

      <%= render "music_info", memory: @memory %>
    </article>

    <nav class="memory-navigation" aria-label="ページ移動">
      <%= link_to "投稿一覧に戻る",
            memories_path,
            class: "memories-button" %>

      <% if logged_in? && @memory.user_id == current_user.id %>
        <%= link_to "編集する",
              edit_memory_path(@memory),
              class: "memories-button" %>

        <%= button_to "削除する",
              memory_path(@memory),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "この投稿を削除しますか？この操作は取り消せません。"
                }
              },
              class: "memories-button" %>
      <% end %>
    </nav>
  </div>
</main>
