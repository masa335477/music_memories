<main class="memories-page memory-browse-page">
  <div class="memories-container">
    <div class="memory-browse-intro">
      <p class="memory-browse-eyebrow">MUSIC MEMORIES</p>
      <h1 class="memories-page-title">投稿一覧</h1>
      <p>音楽にまつわる感想や思い出を見つけましょう。</p>
    </div>

    <%= form_with url: memories_path, method: :get, local: true, class: "search-filter-form", role: "search" do |form| %>
      <div class="search-filter-field">
        <%= form.label :q, "投稿を検索" %>
        <%= form.search_field :q, value: @query, class: "search-input", aria: { describedby: "memory-search-help" } %>
        <small id="memory-search-help">タイトル・本文、楽曲名・アルバム名・アーティスト名、タグで検索できます。タグだけを探すときは「#ロック」のように入力してください。</small>
      </div>
      <% if @tags.any? %>
        <div class="search-filter-field">
          <%= form.label :tag_id, "タグで絞り込む" %>
          <%= form.collection_select :tag_id, @tags, :id, :name,
                { include_blank: "すべてのタグ", selected: @selected_tag_id }, { class: "search-input" } %>
        </div>
      <% end %>
      <div class="memory-search-actions">
        <%= form.submit "検索", name: nil, class: "memories-button" %>
        <%= link_to "検索をクリア", memories_path if @search_active %>
      </div>
    <% end %>

    <% if @memories.empty? %>
      <p class="memories-empty"><%= @search_active ? "検索条件に一致する投稿がありません。" : "まだ投稿がありません。" %></p>
    <% else %>
      <div class="memories-list">
        <% @memories.each do |memory| %>
          <article class="memory-card">
            <h2><%= link_to memory.title, memory_path(memory) %></h2>

            <div class="memory-meta">
              <span>投稿者：<%= memory.user.name %></span>
              <time datetime="<%= memory.created_at.iso8601 %>">
                <%= memory.created_at.strftime("%Y/%m/%d %H:%M") %>
              </time>
            </div>

            <div class="memory-body">
              <%= simple_format(memory.body) %>
            </div>

            <%= render "music_info", memory: memory %>
            <%= render "tags", memory: memory %>

            <%= link_to "投稿詳細を見る", memory_path(memory), class: "memory-detail-link" %>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
